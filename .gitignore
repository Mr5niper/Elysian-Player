# ---- PyInstaller build artifacts ----
# The .spec is generated by BUILD_EXE.bat at build time and deleted again
# afterward, so we never track it.
*.spec
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python caches / compiled files ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ---- App-generated runtime files ----
# Settings, session state and the log are written to the user's home directory
# (~/.elysian_player.json, ~/.elysian_player.log), not into the repo, so there
# is nothing to ignore for those. Playlists the user saves are wherever they
# chose.
*.m3u

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
