# ---- PyInstaller build artifacts ----
# The .spec is generated by BUILD_EXE.bat at build time and deleted again
# afterward, so we never track it.
*.spec
build/
dist/

# ---- Virtual environments ----
.venv/
venv/
env/

# ---- Python caches / compiled files ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# ---- App-generated runtime files ----
# Settings, the library index, the art cache, session state and the log all
# live in one folder in the user's home directory (~/.elysian_player/), not
# in the repo, so there is nothing to ignore for those. Playlists the user
# saves are wherever they chose. index.boot.html is different: host.py
# writes it fresh, on every launch, directly next to the real index.html
# (see host._index_path), so that a relative reference from it to
# style.css/app.js still resolves - a frozen build's copy lands in a
# PyInstaller extraction directory instead, never in the repo, but running
# from source writes it right here.
*.m3u
elysian/web/index.boot.html

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
