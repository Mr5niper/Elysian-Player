# Portable test build of the real engine, now FFmpeg-backed for demux and
# decode. The Windows DLL is produced by BUILD_DLL_REAL.bat, which links
# the same libraries by name against the bundled FFmpeg import libs.
CXX ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -fPIC -fvisibility=hidden -pthread
FFMPEG_CFLAGS := $(shell pkg-config --cflags libavformat libavcodec libavutil libswscale libswresample)
FFMPEG_LIBS := $(shell pkg-config --libs libavformat libavcodec libavutil libswscale libswresample)

SRC = src/real/abi_exports.cpp src/real/player.cpp src/real/clock.cpp \
      src/real/queue.cpp src/real/mp4_demux.cpp src/real/aac_decode.cpp \
      src/real/h264_decode.cpp src/real/audio_out.cpp src/real/video_out.cpp

# -ldl: miniaudio dlopen's the real backend library (libasound.so.2,
# libpulse.so, etc.) at runtime rather than linking it directly, which is
# what lets one build support multiple backends without a hard dependency
# on any of them being present at compile time.
libelysian_video_real.so: $(SRC) include/elysian_video.h
	$(CXX) $(CXXFLAGS) $(FFMPEG_CFLAGS) -shared -o $@ $(SRC) $(FFMPEG_LIBS) -ldl

clean:
	rm -f libelysian_video_real.so
